rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // A user reads and writes only their own tree.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /people/{personId}        { allow read, write: if isOwner(userId); }
      match /journeys/{journeyId}     { allow read, write: if isOwner(userId); }
      match /conversations/{convId}   { allow read, write: if isOwner(userId); }
      match /saved_searches/{savedId} { allow read, write: if isOwner(userId); }
      match /watches/{watchId}        { allow read, write: if isOwner(userId); }

      // Notifications are written by Cloud Functions (admin SDK bypasses rules).
      // The client may only mark one read.
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['read']);
        allow delete: if false;
      }
    }

    // Master data: read-only to signed-in clients, seeded by admin only.
    match /trains/{trainId}     { allow read: if signedIn(); allow write: if false; }
    match /stations/{stationId} { allow read: if signedIn(); allow write: if false; }

    // Booking + live records. Readable by the owner, written only by functions.
    match /pnr_status/{pnr} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /journey_tracking/{pnr} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Explainability trail. Append-only from the client, never edited or read back
    // across users.
    match /audit_logs/{logId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
