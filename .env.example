# ---------------------------------------------------------------------------
# Client (Vite). These are Firebase's PUBLIC config values — they identify the
# project, they do not authorise anything. Safe in the browser bundle.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push (FCM). Generate under Project settings → Cloud Messaging → Web Push.
VITE_FIREBASE_VAPID_KEY=

# Region your Cloud Functions are deployed to.
VITE_FUNCTIONS_REGION=asia-south1

# Point the client at the local emulator suite instead of the live project.
VITE_USE_EMULATORS=false

# ---------------------------------------------------------------------------
# Server (Cloud Functions runtime). NEVER in the client bundle, never in git.
# Put this in functions/.env — which .gitignore already excludes.
#
#   GROQ_API_KEY=gsk_...
#
# or, using functions config:
#   firebase functions:config:set groq.key="gsk_..."
#
# Generate a fresh key at https://console.groq.com — a key that has ever been
# pasted into a chat, a ticket or a commit must be rotated before use.
# ---------------------------------------------------------------------------
